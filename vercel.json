{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "https://alejandros-mac-mini.tail30d0d0.ts.net/webhook/dental-intake?event=proposal&lead_id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/audits/garza-event-hall",
      "destination": "/audits/venue/garza-event-hall/",
      "permanent": true
    },
    {
      "source": "/audits/garza-event-hall/",
      "destination": "/audits/venue/garza-event-hall/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
